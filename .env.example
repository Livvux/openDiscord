# Public hostname. Use "localhost" for a local trial (Caddy issues a local cert).
DOMAIN=localhost
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Optional native versioned encryption keys: newest first, e.g. 2:<new-secret>,1:<previous-secret>.
# Keep BETTER_AUTH_SECRET unchanged to decrypt legacy records. See SELF-HOSTING rotation steps.
BETTER_AUTH_SECRETS=
# Optional. When set, new accounts must verify their email address.
# Example: smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM="opendiscord <no-reply@example.com>"

# Optional. Behind Cloudflare (proxied DNS), set to Cloudflare's IP ranges so rate limits see real
# client IPs (docs/SELF-HOSTING.md). Leave unset when clients connect to Caddy directly.
TRUSTED_PROXIES=

# Optional. Cloudflare Turnstile on sign-up (both keys, or neither).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional GIF picker providers (browser API keys are exposed to authenticated users).
# Provide at least one key; providing both enables a provider switch.
KLIPY_APP_KEY=
GIPHY_API_KEY=

# Optional. Image attachments in S3-compatible storage such as Cloudflare R2 (all four, or none).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. Voice channels with LiveKit (docs/SELF-HOSTING.md#voice-channels). Start the stack with
# `docker compose --profile voice up -d`. Generate the secret with: openssl rand -base64 32
# Browsers connect to LIVEKIT_URL; with the bundled Caddy that's wss://$DOMAIN/livekit.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. Web Push for mentions (generate once: npx web-push generate-vapid-keys).
# Browsers deliver pushes through their vendor's push service; payloads are end-to-end encrypted.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Private local attachments instead of all R2_* settings. Mount a persistent writable volume first; see SELF-HOSTING.md.
# Absolute in-container path; never under public/.
ATTACHMENT_DIR=""
# Optional clamd on a private trusted network; scanner errors/timeouts reject uploads.
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# Registration policy (self-attestation; no birth date or identity document is collected).
MINIMUM_AGE="16"
# Public operator details for legal pages. Official opendiscord.app has operator-approved defaults.
# Other domains must supply all four values; never use another operator's identity.
OPERATOR_NAME=""
OPERATOR_ADDRESS=""
OPERATOR_COUNTRY=""
OPERATOR_EMAIL=""
