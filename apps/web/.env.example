# Local development (pnpm dev) against compose.dev.yaml
DATABASE_URL=postgres://opendiscord:opendiscord@localhost:5433/opendiscord
BETTER_AUTH_SECRET=dev-secret-change-me-dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
SMTP_URL=

# Optional: Cloudflare Turnstile on sign-up (both keys, or neither). Create a widget for your domain.
# Note: the challenge is served by Cloudflare and sees the visitor's IP (docs/PRIVACY.md).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: image attachments in S3-compatible storage (Cloudflare R2). All four, or uploads stay off.
# R2: R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com (EU jurisdiction: <account-id>.eu.r2...)
# Use a bucket-scoped token with "Object Read & Write" only; the bucket must not be public.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
