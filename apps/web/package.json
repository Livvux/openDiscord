{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:schema": "auth generate --config src/lib/auth.ts --output src/db/auth-schema.ts --yes",
    "test:e2e": "playwright test",
    "admin:bootstrap": "tsx --env-file=.env scripts/bootstrap-instance-admin.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "maintenance:voice": "tsx scripts/voice-maintenance.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "1.7.7",
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "livekit-client": "2.22.4",
    "livekit-server-sdk": "2.19.1",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.9.1"
}
